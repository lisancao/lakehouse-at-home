# Test command
cmd_test() {
    set +e  # Disable exit on error for tests
    header "RUNNING TESTS"
    local master_container=$(get_spark_master_container)
    local failures=0

    echo -e "${YELLOW}1. Testing PostgreSQL connection...${NC}"
    local pg_user="${POSTGRES_USER:-postgres}"
    local pg_pass="${POSTGRES_PASSWORD:-}"
    local pg_host="${POSTGRES_HOST:-localhost}"
    pg_host="${pg_host/host.docker.internal/localhost}"  # Convert Docker hostname to localhost
    if PGPASSWORD="$pg_pass" psql -h "$pg_host" -U "$pg_user" -d iceberg_catalog -c "SELECT 1;" >/dev/null 2>&1; then
        echo -e "   ${GREEN}✓${NC} PostgreSQL connected"
    else
        echo -e "   ${RED}✗${NC} PostgreSQL failed"
        echo -e "   ${YELLOW}→ Check: systemctl status postgresql${NC}"
        echo -e "   ${YELLOW}→ Verify POSTGRES_USER in .env matches your database user${NC}"
