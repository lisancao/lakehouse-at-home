    fi

    echo -e "\n${YELLOW}2. Testing SeaweedFS (S3)...${NC}"
    if curl -s --connect-timeout 5 http://localhost:8333 > /dev/null 2>&1; then
        echo -e "   ${GREEN}✓${NC} SeaweedFS responding"
    else
        echo -e "   ${RED}✗${NC} SeaweedFS not responding on port 8333"
        echo -e "   ${YELLOW}→ Check if SeaweedFS is running${NC}"
        ((failures++))
    fi

    echo -e "\n${YELLOW}3. Testing Kafka...${NC}"
    if docker ps --format '{{.Names}}' | grep -q '^kafka$'; then
        if docker exec kafka kafka-topics --list --bootstrap-server localhost:9092 >/dev/null 2>&1; then
            echo -e "   ${GREEN}✓${NC} Kafka broker healthy"
        else
            echo -e "   ${RED}✗${NC} Kafka broker not responding"
            echo -e "   ${YELLOW}→ Check: docker logs kafka${NC}"
            ((failures++))
        fi
    else
        echo -e "   ${RED}✗${NC} Kafka container not running"
        echo -e "   ${YELLOW}→ Run: ./lakehouse start kafka${NC}"
        ((failures++))
    fi

    echo -e "\n${YELLOW}4. Testing Spark $SPARK_VERSION...${NC}"
    if docker ps --format '{{.Names}}' | grep -q "^${master_container}$"; then
        if docker exec "$master_container" /opt/spark/bin/spark-submit --version >/dev/null 2>&1; then
            echo -e "   ${GREEN}✓${NC} Spark master healthy ($master_container)"
        else
            echo -e "   ${RED}✗${NC} Spark not responding"
            echo -e "   ${YELLOW}→ Check: docker logs $master_container${NC}"
            ((failures++))
        fi
    else
        echo -e "   ${RED}✗${NC} Spark container not running ($master_container)"
        echo -e "   ${YELLOW}→ Run: ./lakehouse start spark${NC}"
        ((failures++))
    fi

    echo -e "\n${YELLOW}5. Testing Unity Catalog (optional)...${NC}"
    if docker ps --format '{{.Names}}' | grep -q '^unity-catalog$'; then
        if curl -s --connect-timeout 5 http://localhost:8080/api/2.1/unity-catalog/catalogs > /dev/null 2>&1; then
            echo -e "   ${GREEN}✓${NC} Unity Catalog REST API healthy"
            # Test Iceberg REST endpoint
            if curl -s --connect-timeout 5 http://localhost:8080/api/2.1/unity-catalog/iceberg/v1/config > /dev/null 2>&1; then
                echo -e "   ${GREEN}✓${NC} Iceberg REST Catalog endpoint available"
            else
                echo -e "   ${YELLOW}!${NC} Iceberg REST endpoint not responding (may need configuration)"
            fi
        else
            echo -e "   ${RED}✗${NC} Unity Catalog not responding"
            echo -e "   ${YELLOW}→ Check: docker logs unity-catalog${NC}"
            ((failures++))
        fi
    else
        echo -e "   ${YELLOW}-${NC} Unity Catalog not running (optional)"
        echo -e "   ${YELLOW}→ Run: ./lakehouse start unity-catalog${NC}"
    fi

    echo -e "\n${YELLOW}6. Testing Airflow (optional)...${NC}"
    if docker ps --format '{{.Names}}' | grep -q '^airflow-webserver$'; then
        if curl -s --connect-timeout 5 http://localhost:8085/health | grep -q '"healthy"'; then
            echo -e "   ${GREEN}✓${NC} Airflow webserver healthy"
            if docker ps --format '{{.Names}}' | grep -q '^airflow-scheduler$'; then
                echo -e "   ${GREEN}✓${NC} Airflow scheduler running"
            else
                echo -e "   ${RED}✗${NC} Airflow scheduler not running"
                ((failures++))
            fi
        else
            echo -e "   ${RED}✗${NC} Airflow webserver not responding"
            echo -e "   ${YELLOW}→ Check: docker logs airflow-webserver${NC}"
            ((failures++))
        fi
    else
        echo -e "   ${YELLOW}-${NC} Airflow not running (optional)"
        echo -e "   ${YELLOW}→ Run: ./lakehouse start airflow${NC}"
    fi

    # Summary
    set -e  # Re-enable exit on error
    echo -e "\n${BLUE}================================${NC}"
    if [ $failures -eq 0 ]; then
        echo -e "${GREEN}All tests passed!${NC}"
        return 0
    else
        echo -e "${RED}$failures test(s) failed${NC}"
        echo -e "Run ${YELLOW}./lakehouse setup${NC} to diagnose issues"
        return 1
    fi
}

